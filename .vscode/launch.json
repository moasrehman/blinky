    "version": "0.2.0",
    "configurations": [
        {
            "cwd": "${workspaceFolder}",
            "executable": "./bin/executable.elf",
            "name": "Debug with JLink",
            "request": "launch",
            "type": "cortex-debug",
            "device": "",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none",
            "servertype": "jlink"
        },
        {
            "type": "nrf-connect",
            "request": "launch",
            "name": "Launch the active build configuration",
            "config": "${activeConfig}",
            "runToEntryPoint": "main"
        }
    ]
}